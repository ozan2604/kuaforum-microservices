{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7195
        }
      ],
      "UpstreamPathTemplate": "/identity/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": {
        "AllowedScopes": [],
         "AuthenticationProviderKey": "Bearer"
      },
      "RouteIsCaseSensitive": false, //Harf duyarlýlýðý olmaz; /Auth/Login ve /auth/login ayný route olarak eþleþir.
      "DangerousAcceptAnyServerCertificateValidator": true // Sertifika doðrulamasý yapýlmaz; bu, geliþtirme ortamýnda kullanýlmalýdýr.
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7181
        }
      ],
      "UpstreamPathTemplate": "/log/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": {
        "AllowedScopes": [],
        "AuthenticationProviderKey": "Bearer"  //tokený al
      },
     
      "RouteIsCaseSensitive": false,
      "DangerousAcceptAnyServerCertificateValidator": true
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7108
        }
      ],
      "UpstreamPathTemplate": "/notification/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": {
        "AllowedScopes": [],
        "AuthenticationProviderKey": "Bearer"
      },

      "RouteClaimsRequirement": {
        "Role": "Admin" //buraya rolleri atýyoruz. Token rolü karþýlýyor mu
      },
      "RouteIsCaseSensitive": false,
      "DangerousAcceptAnyServerCertificateValidator": true
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7207"
    //"ServiceDiscoveryProvider": {
    //  "Host": "localhost",
    //  "Port": 8500,
    //  "Type": "Consul"
    //},
    //"RequestIdKey": "OcRequestId",
    //"AdministrationPath": "/admin"
  }
}